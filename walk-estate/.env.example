# ------------------------------------------------------------------
# 카카오맵 연동 (없으면 자동으로 시뮬레이션 캔버스로 폴백됩니다)
# ------------------------------------------------------------------
# 1) https://developers.kakao.com → 내 애플리케이션 → 앱 생성
# 2) 앱 키 > JavaScript 키를 아래에 넣습니다 (브라우저에 노출되는 값)
# 3) 플랫폼 > Web > 사이트 도메인에 http://localhost:3000 을 반드시 등록
NEXT_PUBLIC_KAKAO_JS_KEY=

# 앱 키 > REST API 키 (서버에서만 사용, 절대 클라이언트로 내보내지 않음)
# 장소 검색·좌표 변환(Local API)에 사용합니다.
KAKAO_REST_API_KEY=

# ------------------------------------------------------------------
# 도보 실경로 (선택)
# 카카오모빌리티 '도보 길찾기'는 제휴 파트너 전용이라 일반 키로 쓸 수 없습니다.
# Tmap 보행자 경로안내 키를 넣으면 실제 보행 경로/거리로 계산하고,
# 비워두면 직선거리 × 우회계수(1.25)로 근사합니다.
# https://openapi.sk.com → 앱 생성 → appKey
TMAP_APP_KEY=

# ------------------------------------------------------------------
# 테스트 전용 — 목 서버로 통합 테스트할 때만 사용합니다. 평소에는 비워두세요.
# ------------------------------------------------------------------
# KAKAO_LOCAL_BASE=http://127.0.0.1:4010/v2/local
# TMAP_BASE=http://127.0.0.1:4010
